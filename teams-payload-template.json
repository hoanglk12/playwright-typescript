{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "contentUrl": null,
      "content": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.2",
        "body": [
          { "type": "TextBlock", "size": "Large", "weight": "Bolder", "text": "Lighthouse CI - Platypus Storefronts" },
          { "type": "FactSet", "facts": [
            { "title": "Status", "value": "${STATUS}" },
            { "title": "Branch", "value": "${BITBUCKET_BRANCH}" },
            { "title": "Build", "value": "${BITBUCKET_BUILD_NUMBER}" },
            { "title": "Runs per URL", "value": "${LHCI_RUNS}" }
          ]},
          { "type": "TextBlock", "wrap": true, "text": "[View Lighthouse Report](${FIREBASE_URL})" }
        ]
      }
    }
  ]
}
