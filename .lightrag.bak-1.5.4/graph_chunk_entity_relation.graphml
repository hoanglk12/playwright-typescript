<node id="GraphQL Strings Hoisting Rule">
  <data key="d0">GraphQL Strings Hoisting Rule</data>
  <data key="d1">concept</data>
  <data key="d2">Quality rule that mandates all GraphQL strings be module-level constants, never inlined within tests or beforeAll.</data>
  <data key="d3">doc-13c6ca4c338ad773242cc059a8049dc9-chunk-005</data>
  <data key="d4">gra-api-testing.md</data>
  <data key="d5">1785074431</data>
  <data key="d6"></data>
</node>
<node id="Logger Verify Rule">
  <data key="d0">Logger Verify Rule</data>
  <data key="d1">concept</data>
  <data key="d2">Quality rule stating logger.verify() must be called before softExpect() and that softExpect does not log internally.</data>
  <data key="d3">doc-13c6ca4c338ad773242cc059a8049dc9-chunk-005</data>
  <data key="d4">gra-api-testing.md</data>
  <data key="d5">1785074431</data>
  <data key="d6"></data>
</node>
<node id="Module-level Variable Initialization Rule">
  <data key="d0">Module-level Variable Initialization Rule</data>
  <data key="d1">concept</data>
  <data key="d2">Requirement that module-level variables must have explicit initializers, e.g., let customerToken: string = ''.</data>
  <data key="d3">doc-13c6ca4c338ad773242cc059a8049dc9-chunk-005</data>
  <data key="d4">gra-api-testing.md</data>
  <data key="d5">1785074431</data>
  <data key="d6"></data>
</node>
<node id="AuthType.BEARER Enum Rule">
  <data key="d0">AuthType.BEARER Enum Rule</data>
  <data key="d1">concept</data>
  <data key="d2">Rule specifying use of AuthType.BEARER enum rather than string literals like "bearer" as any.</data>
  <data key="d3">doc-13c6ca4c338ad773242cc059a8049dc9-chunk-005</data>
  <data key="d4">gra-api-testing.md</data>
  <data key="d5">1785074431</data>
  <data key="d6"></data>
</node>
<node id="Test Describe Configure Rule">
  <data key="d0">Test Describe Configure Rule</data>
  <data key="d1">concept</data>
  <data key="d2">Rule advising against adding test.describe.configure({ mode: 'serial' }) to GRA specs to avoid cascading skips on failure.</data>
  <data key="d3">doc-13c6ca4c338ad773242cc059a8049dc9-chunk-005</data>
  <data key="d4">gra-api-testing.md</data>
  <data key="d5">1785074431</data>
  <data key="d6"></data>
</node>
<node id="Errors Optional Chaining Rule">
  <data key="d0">Errors Optional Chaining Rule</data>
  <data key="d1">concept</data>
  <data key="d2">Rule recommending guarding errors[0] access with optional chaining even inside length checks in TypeScript.</data>
  <data key="d3">doc-13c6ca4c338ad773242cc059a8049dc9-chunk-005</data>
  <data key="d4">gra-api-testing.md</data>
  <data key="d5">1785074431</data>
  <data key="d6"></data>
</node>
