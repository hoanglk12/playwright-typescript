<node id="Bazaarvoice">
  <data key="d0">Bazaarvoice</data>
  <data key="d1">organization</data>
  <data key="d2">A third-party service providing customer review and ratings functionality, integrated via GraphQL operations.&lt;SEP&gt;A third-party provider of review aggregation used by brands like Platypus, Skechers, Vans, and Dr. Martens.&lt;SEP&gt;A company providing tools for managing session IDs, mentioned in the context of cookies BVBRANDID and BVBRANDSID.&lt;SEP&gt;A platform for reviews that loads client-specific configurations (e.g., platypusshoes-anz and drmartens-anz on specific AU/NZ websites).</data>
  <data key="d3">doc-c9488069466f7da02e04d0a79614e167-chunk-000&lt;SEP&gt;doc-c9488069466f7da02e04d0a79614e167-chunk-002&lt;SEP&gt;doc-c9488069466f7da02e04d0a79614e167-chunk-001&lt;SEP&gt;doc-c9488069466f7da02e04d0a79614e167-chunk-004</data>
