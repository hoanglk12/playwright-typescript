<node id="Attraqt">
  <data key="d0">Attraqt</data>
  <data key="d1">organization</data>
  <data key="d2">A third-party service used for session storage in localStorage within the investigated storefronts.&lt;SEP&gt;A third-party service that provides search analytics for brands such as Platypus, Skechers, Vans, and Dr. Martens.&lt;SEP&gt;A provider of analytics services that fire requests to collect-ap2.attraqt.io on every page load.</data>
  <data key="d3">doc-c9488069466f7da02e04d0a79614e167-chunk-000&lt;SEP&gt;doc-c9488069466f7da02e04d0a79614e167-chunk-001&lt;SEP&gt;doc-c9488069466f7da02e04d0a79614e167-chunk-004</data>
