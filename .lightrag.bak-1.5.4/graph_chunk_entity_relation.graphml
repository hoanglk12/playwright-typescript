<node id="Playwright MCP">
  <data key="d0">Playwright MCP</data>
  <data key="d1">artifact</data>
  <data key="d2">A browser automation tool used for JavaScript evaluation, in-page technology detection, and network request analysis during the investigation.&lt;SEP&gt;A browser testing tool used to confirm live behavior of the header "Help" figure-trigger and flyout on the staging environment.</data>
  <data key="d3">doc-c9488069466f7da02e04d0a79614e167-chunk-000&lt;SEP&gt;doc-a74540e7570b89ad3bb5cb22795ee605-chunk-000</data>
