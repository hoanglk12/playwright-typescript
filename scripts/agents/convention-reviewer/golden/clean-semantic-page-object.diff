+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommerceReturnsPage extends BasePage {
+  private readonly returnsLink = this.page.getByRole('link', { name: 'Returns' });
+  private readonly policyText = this.page.getByText('Free returns within 30 days');
+
+  constructor(page: Page) { super(page); }
+
+  async openReturns(): Promise<void> {
+    await this.returnsLink.click();
+  }
+
+  async isPolicyVisible(): Promise<boolean> {
+    return this.policyText.isVisible();
+  }
+}
