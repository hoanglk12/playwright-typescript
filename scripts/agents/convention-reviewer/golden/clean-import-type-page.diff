+import type { Page } from '@playwright/test';
+import { test, expect } from '@config/base-test';
+import { createTestLogger } from '../../src/utils/test-logger';
+
+async function currentPath(page: Page): Promise<string> {
+  return new URL(page.url()).pathname;
+}
+
+test.describe('Helper usage @ecommerce @smoke', () => {
+  test('E2E-HELPER-001 - Path starts at root', async ({ page, ecommerceHomePage }) => {
+    const logger = createTestLogger('E2E-HELPER-001 path starts at root');
+
+    logger.step('Step 1 - Open home');
+    await ecommerceHomePage.navigateToHomePage();
+
+    logger.step('Step 2 - Assert path');
+    expect(await currentPath(page)).toBe('/');
+  });
+});
