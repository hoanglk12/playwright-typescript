+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommercePromoListPage extends BasePage {
+  private readonly secondItemSelector = 'div.promo-list > ul > li:nth-child(2) > a';
+
+  constructor(page: Page) { super(page); }
+
+  async openSecondPromo(): Promise<void> {
+    await this.elements.clickElement(this.secondItemSelector);
+  }
+}
