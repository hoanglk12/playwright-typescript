+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommerceSalePage extends BasePage {
+  private readonly saleLinkSelector = '[data-testid="sale-link"]';
+
+  constructor(page: Page) { super(page); }
+
+  async openSale(): Promise<void> {
+    // 🚀 jump straight to the sale listing
+    await this.elements.clickElement(this.saleLinkSelector);
+  }
+}
