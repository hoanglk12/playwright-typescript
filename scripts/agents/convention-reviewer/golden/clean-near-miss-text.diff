+import { test, expect } from '@config/base-test';
+import { StoreLocatorData } from '../../src/data/ecommerce/store-locator-data';
+import { createTestLogger } from '../../src/utils/test-logger';
+
+// Docs: https://example.test/docs/store-locator
+test.describe('Only logged in stores @ecommerce @regression', () => {
+  test('E2E-STORE-001 - Company stores are listed', async ({ ecommerceHelpSupportPage }) => {
+    const logger = createTestLogger('E2E-STORE-001 company stores listed');
+    const anyOf = StoreLocatorData.REGIONS;
+
+    logger.step('Step 1 - Open store locator');
+    await ecommerceHelpSupportPage.openStoreLocator();
+
+    logger.step('Step 2 - Assert region and company');
+    expect(anyOf).toContain(await ecommerceHelpSupportPage.getRegion());
+    expect(await ecommerceHelpSupportPage.getCompanyName()).toBe(StoreLocatorData.COMPANY_NAME);
+  });
+});
