+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommerceOrderSummaryPage extends BasePage {
+  private readonly firstLinePriceSelector = 'table.order-lines > tbody > tr:first-child > td:last-child';
+
+  constructor(page: Page) { super(page); }
+
+  async getFirstLinePrice(): Promise<string> {
+    return this.elements.getText(this.firstLinePriceSelector);
+  }
+}
