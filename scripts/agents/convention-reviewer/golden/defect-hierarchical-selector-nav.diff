+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommerceMegaMenuPage extends BasePage {
+  private readonly subcategoryLinksSelector = 'nav.mega-menu > div > ul > li > ul > li > a';
+
+  constructor(page: Page) { super(page); }
+
+  async getSubcategoryNames(): Promise<string[]> {
+    return this.dom.getAllTextContents(this.subcategoryLinksSelector);
+  }
+}
