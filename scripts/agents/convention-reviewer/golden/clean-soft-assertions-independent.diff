+import { test, expect } from '@config/base-test';
+import { createTestLogger } from '../../src/utils/test-logger';
+
+test.describe('PDP details @ecommerce @regression', () => {
+  test('E2E-PDP-050 - Details are populated', async ({ ecommercePDPPage, softAssert }) => {
+    const logger = createTestLogger('E2E-PDP-050 details populated');
+
+    logger.step('Step 1 - Open a product');
+    await ecommercePDPPage.openFirstProduct();
+    const title = await ecommercePDPPage.getTitle();
+    expect(title.length).toBeGreaterThan(0);
+
+    logger.step('Step 2 - Verify independent details');
+    softAssert.toBeTruthy(await ecommercePDPPage.hasPrice(), 'Price shown');
+    softAssert.toBeTruthy(await ecommercePDPPage.hasGallery(), 'Gallery shown');
+    softAssert.toBeTruthy(await ecommercePDPPage.hasSizeSelector(), 'Size selector shown');
+  });
+});
