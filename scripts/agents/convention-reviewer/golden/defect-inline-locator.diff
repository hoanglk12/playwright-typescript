+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommercePromoCtaPage extends BasePage {
+  private readonly promoHeading = this.page.getByRole('heading', { name: 'Promotions' });
+
+  constructor(page: Page) { super(page); }
+
+  async clickPromoCta(): Promise<void> {
+    await this.elements.clickElement('[data-testid="promo-cta"]');
+  }
+
+  async isHeadingVisible(): Promise<boolean> {
+    return this.promoHeading.isVisible();
+  }
+}
