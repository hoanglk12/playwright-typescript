+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommerceGiftPage extends BasePage {
+  private readonly giftHeading = this.page.getByRole('heading', { name: 'Gift cards' });
+  private readonly buyButton = this.page.getByRole('button', { name: 'Buy gift card' });
+
+  constructor(page: Page) { super(page); }
+
+  async isHeadingVisible(): Promise<boolean> {
+    return this.giftHeading.isVisible();
+  }
+
+  async buyGiftCard(): Promise<void> {
+    await this.buyButton.click();
+  }
+}
