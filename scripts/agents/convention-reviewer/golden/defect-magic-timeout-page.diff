+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommercePromoPage extends BasePage {
+  private readonly promoBannerSelector = '[data-testid="promo-banner"]';
+
+  constructor(page: Page) { super(page); }
+
+  async waitForPromoBanner(): Promise<void> {
+    await this.waits.waitForElementVisible(this.promoBannerSelector, { timeout: 8000 });
+  }
+}
