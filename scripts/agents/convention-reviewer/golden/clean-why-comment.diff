+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommerceStorePage extends BasePage {
+  private readonly storeLinkSelector = '[data-testid="store-link"]';
+
+  constructor(page: Page) { super(page); }
+
+  async openStore(): Promise<void> {
+    // The link is re-rendered after the geo-IP banner resolves, so a click before that lands on a stale node.
+    await this.waits.waitForPageLoad();
+    await this.elements.clickElement(this.storeLinkSelector);
+  }
+}
