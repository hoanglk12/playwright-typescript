+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommerceSaleBadgePage extends BasePage {
+  private readonly badgeLabel = this.page.getByText('Sale', { exact: true });
+
+  constructor(page: Page) { super(page); }
+
+  async getBadgeColour(): Promise<string> {
+    return this.style.getElementBackgroundColorHex('[data-testid="sale-badge"]');
+  }
+
+  async isBadgeVisible(): Promise<boolean> {
+    return this.badgeLabel.isVisible();
+  }
+}
