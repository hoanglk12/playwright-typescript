+import { Page } from '@playwright/test';
+import { BasePage } from '../base-page';
+
+export class EcommerceStoreFinderPage extends BasePage {
+  private readonly postcodeSelector = '[data-testid="store-postcode"]';
+
+  constructor(page: Page) { super(page); }
+
+  async searchPostcode(postcode: string): Promise<void> {
+    await this.elements.enterText(this.postcodeSelector, postcode);
+  }
+
+  async isNoResultsShown(): Promise<boolean> {
+    const message = this.page.getByText('No stores found near you');
+    return message.isVisible();
+  }
+}
