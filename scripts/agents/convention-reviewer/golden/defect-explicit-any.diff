+export interface LabelData {
+  prefix: string;
+  suffix: string;
+}
+
+export const LabelDefaults: LabelData = {
+  prefix: 'Item',
+  suffix: 'Label',
+};
+
+export function toLabel(value: any): string {
+  return LabelDefaults.prefix + ' ' + String(value) + ' ' + LabelDefaults.suffix;
+}
