{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npm list *)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__playwright__browser_navigate",
      "mcp__atlassian__jira_get_issue",
      "mcp__atlassian__jira_get_issue_comments",
      "mcp__vercel__get_deployment",
      "mcp__vercel__list_deployments",
      "mcp__vercel__get_project",
      "mcp__vercel__list_projects",
      "mcp__vercel__get_runtime_logs",
      "mcp__vercel__web_fetch_vercel_url",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(xargs grep *)",
      "Bash(npx prettier --write *)",
      "Bash(npx playwright test *)",
      "Bash(playwright-cli *)",
      "Bash(npx playwright-cli *)",
      "mcp__playwright-test__browser_verify_element_visible",
      "mcp__playwright-test__browser_verify_text_visible",
      "mcp__playwright-test__browser_verify_list_visible",
      "mcp__playwright-test__browser_verify_value",
      "mcp__playwright-test__browser_wait_for",
      "mcp__lightrag__query_document"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-git-check.js\"",
            "timeout": 15,
            "statusMessage": "Checking for remote changes..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.js\"",
            "timeout": 10,
            "statusMessage": "Safety check..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/user-prompt-submit.js\"",
            "timeout": 15,
            "statusMessage": "Preparing context..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-memory.js\"",
            "timeout": 30,
            "statusMessage": "Syncing memory to vault..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/yaml-check.js\"",
            "timeout": 15,
            "statusMessage": "YAML syntax check..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const j=JSON.parse(d);const cmd=(j.tool_input||{}).command||'';const isTest=/npm (run )?test|npx playwright test/.test(cmd);if(isTest)console.log(JSON.stringify({systemMessage:'Tests complete. Open report: npm run report'}));process.exit(0);})\""
          },
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const j=JSON.parse(d);const cmd=(j.tool_input||{}).command||'';if(!/git (add|stage|commit)/.test(cmd))return process.exit(0);const {spawnSync}=require('child_process');const r=spawnSync('git',['diff','--cached','--name-only'],{encoding:'utf8'});const files=(r.stdout||'').split('\\n').filter(f=>/\\.(ts|tsx|js|jsx)$/.test(f));if(files.length>0)process.stdout.write(JSON.stringify({systemMessage:files.length+' TS/JS file(s) staged \\u2014 re-index codebase-memory-mcp to keep the knowledge graph current.'}));process.exit(0);})\" 2>/dev/null || true",
            "statusMessage": "Checking staged files..."
          }
        ]
      },
      {
        "matcher": "Bash|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/advisor-nudge.js\"",
            "timeout": 10,
            "statusMessage": "Checking for stuck loop..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "output=$(npx tsc --noEmit 2>&1); rc=$?; echo \"$output\"; [ $rc -ne 0 ] && exit 2 || exit 0",
            "timeout": 60,
            "statusMessage": "Final TypeScript check...",
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-changed-specs.js\"",
            "timeout": 300,
            "asyncRewake": true,
            "statusMessage": "Running changed spec tests..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lightrag-sync-status.js\"",
            "timeout": 120,
            "statusMessage": "Syncing vault to LightRAG..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/vault-capture-nudge.js\"",
            "timeout": 15,
            "statusMessage": "Checking for uncaptured session lessons..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const j=JSON.parse(d);process.stdout.write(JSON.stringify({systemMessage:(j.agent_type||'Sub-agent')+' finished.'}));process.exit(0);})\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use-failure.js\"",
            "timeout": 30,
            "statusMessage": "Diagnosing write failure..."
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-batch.js\"",
            "timeout": 90,
            "statusMessage": "Batch TypeScript check..."
          }
        ]
      }
    ]
  }
}
