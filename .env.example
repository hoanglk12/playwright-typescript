# Copy this file to .env.testing / .env.staging / .env.production and fill in real values.
# Never commit files with real values — they are gitignored.
# In CI, all of these are injected via GitHub Environment secrets/vars (see .github/workflows/).

# --- Application URLs (GitHub Environment vars) ---
FRONTSITE_URL=
ADMIN_URL=
API_BASE_URL=

# --- Credentials (GitHub Environment secrets) ---
USER_NAME=
PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
GRA_TEST_PASSWORD=
PAYPAL_SANDBOX_PASSWORD=

# --- Database (GitHub Environment secrets/vars) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- API (GitHub Environment secrets) ---
GRAPHQL_BASE_URL=
GRAPHQL_ENDPOINT=/graphql

# --- Infra tokens (GitHub Repository secrets — same across all envs) ---
# CLOUDFLARE_API_TOKEN=     (set in repo secrets, not per-env)
# CLOUDFLARE_ACCOUNT_ID=    (set in repo secrets)
# SLACK_WEBHOOK_URL=        (set in repo secrets)
# PERCY_TOKEN=              (set in repo secrets)

# --- Jira (local only — for bulk-ingest-jira.mjs, never commit real values) ---
# JIRA_EMAIL=your-email@accentgroup.com.au
# JIRA_API_TOKEN=           (create at https://id.atlassian.com/manage-profile/security/api-tokens)

# --- LLM Council (local only — for scripts/council/dispatch.mjs, dev-time tool, never commit real values) ---
# Never put these in .env.testing / .env.staging / .env.production — this tool is unrelated to
# the Playwright test suite and is never read by src/config/environment.ts. Set in shell env or
# a gitignored .env.local instead.
# OPENROUTER_API_KEY=       (name kept for continuity with the reverted council tool; get a key for COUNCIL_BASE_URL)
# COUNCIL_BASE_URL=         (default: https://direct.shopaikey.com/v1)

# --- Test behaviour (hardcoded defaults in environment.ts — override locally if needed) ---
# HEADLESS=true
# WORKERS=50%
# TIMEOUT=30000
# RETRIES=2
# SCREENSHOT_MODE=only-on-failure
# VIDEO_MODE=retain-on-failure
# TRACE_MODE=on-first-retry
